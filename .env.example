# Copy to `.env` (gitignored) and adjust. Every variable is optional for a local run against the
# backend's own Docker Compose stack. Placeholders only — never commit real values.

# --- target -----------------------------------------------------------------------------------------
# Refused unless the host is recognisably non-production (localhost, private IPs, *.local, *.test,
# Compose service names) or listed in MTP_ALLOWED_HOSTS.
MTP_BASE_URL=http://localhost:8000
MTP_API_PREFIX=/api/v1
# local | ci | staging
MTP_ENVIRONMENT=local
# MTP_ALLOWED_HOSTS=staging-api.example.internal
# MTP_ALLOW_UNSAFE_TARGET=false

# --- transport --------------------------------------------------------------------------------------
MTP_TIMEOUT_SECONDS=10
# Transport-level retries for GET/HEAD/OPTIONS only. HTTP statuses are never retried.
MTP_RETRIES=2

# --- test data --------------------------------------------------------------------------------------
# session: POST /test-data/reset before the run (and around destructive tests). none: never reset.
# Defaults to session for local/ci and none for staging (session is refused against staging).
# MTP_RESET_MODE=session

# Local and CI default to the backend's documented seed accounts. Staging must set all of these.
# MTP_CUSTOMER_EMAIL=<customer-email>
# MTP_CUSTOMER_PASSWORD=<customer-password>
# MTP_PREMIUM_EMAIL=<premium-email>
# MTP_PREMIUM_PASSWORD=<premium-password>
# MTP_ADMIN_EMAIL=<admin-email>
# MTP_ADMIN_PASSWORD=<admin-password>
# MTP_LOCKED_EMAIL=<locked-account-email>
# MTP_LOCKED_PASSWORD=<locked-account-password>

# --- run identity and reporting ---------------------------------------------------------------------
# MTP_RUN_ID=API-LOCAL-001
# The backend exposes no version endpoint outside development; CI passes the backend commit SHA.
# MTP_BACKEND_VERSION=<backend-commit-sha>
# MTP_COMMIT_SHA=<this-repo-commit-sha>
# MTP_BRANCH=<branch>
# MTP_BUILD_URL=<ci-run-url>
MTP_ARTIFACTS_DIR=artifacts
MTP_ATTACHMENT_MAX_BYTES=65536

# --- pact -------------------------------------------------------------------------------------------
MTP_PACT_DIR=pacts
# Contracts generated by the real Android/iOS apps, verified alongside ours.
# MTP_PACT_EXTERNAL_DIR=<path-to-mobile-pacts>
MTP_PACT_CONSUMER_NAME=MobileTestPlayground-Mobile-API
MTP_PACT_PROVIDER_NAME=MobileTestPlayground-Backend-API
# local | broker
MTP_PACT_SOURCE=local
# MTP_PACT_BROKER_URL=https://<your-broker>
# Token OR username/password, not both.
# MTP_PACT_BROKER_TOKEN=<broker-token>
# MTP_PACT_BROKER_USERNAME=<broker-username>
# MTP_PACT_BROKER_PASSWORD=<broker-password>
# Publish provider verification results (needs MTP_PACT_BROKER_URL and MTP_BACKEND_VERSION).
MTP_PACT_PUBLISH_RESULTS=false
